# KYFARU ADMIN — Copy to .env.local

# REQUIRED
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
AUTH_SECRET=replace-with-random-32-char-secret
NEXTAUTH_URL=http://localhost:3000
SEED_ADMIN_EMAIL=admin@kyfaru.com
SEED_ADMIN_PASSWORD=ChangeMeNow!2025
SEED_ADMIN_NAME=Kyfaru Super Admin

# OPTIONAL (blank = stub mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Kyfaru <hello@kyfaru.com>
COMPANY_INBOX_EMAIL=hello@kyfaru.com
# Twilio (SMS + WhatsApp). WhatsApp "from" must be like: whatsapp:+14155238886
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
SENTDM_API_KEY=
SENTDM_SENDER_ID=KYFARU
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com
# Server-side PostHog Query API (admin dashboard analytics widget)
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://eu.posthog.com
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=
CRON_SECRET=replace-with-random-cron-secret
# Upstash Redis (admin dashboard/finance caching - blank = uncached, reads still work)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
